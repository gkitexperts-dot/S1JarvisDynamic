<UserControl x:Class="S1Jarvis.UI.VerilicMaintenanceShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="720" MinHeight="420">
    <Grid Background="#1E1E2E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2A2A3D" Padding="18" BorderBrush="#3A3A50" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Verilic Licensing Maintenance" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Provision, activate and inspect local readiness for the S1 Jarvis product family."
                               Foreground="#B8B8C8" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Row="0" Grid.Column="1" Content="Refresh" Padding="16,7" Margin="12,0,0,0" Click="Refresh_Click" />

                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Provisioning code" Foreground="#D6D6E6" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox x:Name="provisioningCodeTextBox" Grid.Column="1" MinWidth="330" Padding="8,5" />
                    <Button x:Name="importFromVerilicButton" Grid.Column="2" Content="Import from Verilic" Padding="16,7" Margin="8,0,0,0" Click="ImportFromVerilic_Click" />
                    <Button Grid.Column="3" Content="Legacy Windows import" Padding="14,7" Margin="8,0,0,0" Click="ImportUserConfiguration_Click" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="18,16,18,0" Padding="12" Background="#252538" CornerRadius="5">
            <TextBlock x:Name="modeStatusText" Foreground="#D6D6E6" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2" Margin="18,16,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Product" Foreground="#B8B8C8" FontWeight="SemiBold" Margin="8,4" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Configured" Foreground="#B8B8C8" FontWeight="SemiBold" Margin="8,4" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Activation refs" Foreground="#B8B8C8" FontWeight="SemiBold" Margin="8,4" />
            <TextBlock Grid.Row="0" Grid.Column="3" Text="Local state" Foreground="#B8B8C8" FontWeight="SemiBold" Margin="8,4" />
            <TextBlock Grid.Row="0" Grid.Column="4" Text="Runtime ready" Foreground="#B8B8C8" FontWeight="SemiBold" Margin="8,4" />
            <TextBlock Grid.Row="0" Grid.Column="5" Text="Action" Foreground="#B8B8C8" FontWeight="SemiBold" Margin="8,4" />

            <Border Grid.Row="1" Grid.ColumnSpan="6" BorderBrush="#3A3A50" BorderThickness="0,1,0,0" />

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="8,12,8,10">
                <TextBlock Text="S1 Jarvis" Foreground="White" FontWeight="SemiBold" />
                <TextBlock Text="S1JARVIS" Foreground="#8F8FA8" FontSize="11" />
            </StackPanel>
            <TextBlock x:Name="jarvisConfiguredText" Grid.Row="1" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Margin="8" />
            <TextBlock x:Name="jarvisRefsText" Grid.Row="1" Grid.Column="2" Foreground="White" VerticalAlignment="Center" Margin="8" />
            <TextBlock x:Name="jarvisStateText" Grid.Row="1" Grid.Column="3" Foreground="White" VerticalAlignment="Center" Margin="8" />
            <TextBlock x:Name="jarvisReadyText" Grid.Row="1" Grid.Column="4" Foreground="White" VerticalAlignment="Center" Margin="8" />
            <Button x:Name="activateJarvisButton" Grid.Row="1" Grid.Column="5" Content="Activate" Padding="12,5" Margin="8" Click="ActivateJarvis_Click" />

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="8,12,8,10">
                <TextBlock Text="Jarvis Courier" Foreground="White" FontWeight="SemiBold" />
                <TextBlock Text="S1JARVISCOURIER" Foreground="#8F8FA8" FontSize="11" />
            </StackPanel>
            <TextBlock x:Name="courierConfiguredText" Grid.Row="2" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Margin="8" />
            <TextBlock x:Name="courierRefsText" Grid.Row="2" Grid.Column="2" Foreground="White" VerticalAlignment="Center" Margin="8" />
            <TextBlock x:Name="courierStateText" Grid.Row="2" Grid.Column="3" Foreground="White" VerticalAlignment="Center" Margin="8" />
            <TextBlock x:Name="courierReadyText" Grid.Row="2" Grid.Column="4" Foreground="White" VerticalAlignment="Center" Margin="8" />
            <Button x:Name="activateCourierButton" Grid.Row="2" Grid.Column="5" Content="Activate" Padding="12,5" Margin="8" Click="ActivateCourier_Click" />

            <StackPanel Grid.Row="3" Grid.Column="0" Margin="8,12,8,10" VerticalAlignment="Top">
                <TextBlock Text="Jarvis DocReader" Foreground="White" FontWeight="SemiBold" />
                <TextBlock Text="S1JARVISDOCREADER" Foreground="#8F8FA8" FontSize="11" />
            </StackPanel>
            <TextBlock x:Name="docReaderConfiguredText" Grid.Row="3" Grid.Column="1" Foreground="White" VerticalAlignment="Top" Margin="8,16,8,8" />
            <TextBlock x:Name="docReaderRefsText" Grid.Row="3" Grid.Column="2" Foreground="White" VerticalAlignment="Top" Margin="8,16,8,8" />
            <TextBlock x:Name="docReaderStateText" Grid.Row="3" Grid.Column="3" Foreground="White" VerticalAlignment="Top" Margin="8,16,8,8" />
            <TextBlock x:Name="docReaderReadyText" Grid.Row="3" Grid.Column="4" Foreground="White" VerticalAlignment="Top" Margin="8,16,8,8" />
            <Button x:Name="activateDocReaderButton" Grid.Row="3" Grid.Column="5" Content="Activate" Padding="12,5" Margin="8,12,8,8" VerticalAlignment="Top" Click="ActivateDocReader_Click" />
        </Grid>

        <Border Grid.Row="3" Background="#2A2A3D" Padding="14" BorderBrush="#3A3A50" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="resultText" Foreground="#D6D6E6" VerticalAlignment="Center" Text="No maintenance action has been run." TextWrapping="Wrap" />
                <Button x:Name="activateAllButton" Grid.Column="1" Content="Activate all configured products" Padding="16,7" Margin="12,0,0,0" Click="ActivateAll_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

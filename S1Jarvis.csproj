  <ItemGroup>
    <!-- ΑΛΛΑΓΗ 20/08, ρητό αίτημα χρήστη - "ολο το deploy να ειναι ενα
         αρχειο": ΠΡΙΝ ήταν Content/CopyToOutputDirectory (loose αρχείο
         δίπλα στο DLL, web\index.html). ΤΩΡΑ EmbeddedResource - μπαίνει
         ΜΕΣΑ στο ίδιο το S1Jarvis.dll (βλ. S1Jarvis.csproj). LogicalName ΡΗΤΑ ορισμένο (όχι
         namespace-inference) - πρέπει να ταιριάζει ΑΚΡΙΒΩΣ με τα literal
         strings στο JarvisShell.xaml.cs::ServeEmbeddedWebResource. -->
    <EmbeddedResource Include="UI\web\index.html">
      <LogicalName>S1Jarvis.web.index.html</LogicalName>
    </EmbeddedResource>
    <!-- ΝΕΟ 18/08, ρητό αίτημα χρήστη - Chart.js (v4.4.4, τοπικό αντίγραφο,
         ΟΧΙ CDN - το WebView2 μπορεί να μην έχει πάντα internet, ίδιο
         σκεπτικό με τα υπόλοιπα vendored dlls). Φορτώνεται με <script src>
         στο index.html (βλ. εκεί). ΑΛΛΑΓΗ 20/08: ίδιο idiom με το
         index.html πιο πάνω - EmbeddedResource αντί για Content. -->
    <EmbeddedResource Include="UI\web\vendor\chart.umd.min.js">
      <LogicalName>S1Jarvis.web.vendor.chart.umd.min.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

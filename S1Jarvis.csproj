<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{ACD54FA8-8A8D-4170-903F-8E9E1B6733AA}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>S1Jarvis</RootNamespace>
    <AssemblyName>S1Jarvis</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols><DebugType>full</DebugType><Optimize>false</Optimize>
    <OutputPath>..\..\..\Program Files\Soft1Core\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants><ErrorReport>prompt</ErrorReport><WarningLevel>4</WarningLevel><PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType><Optimize>true</Optimize><OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants><ErrorReport>prompt</ErrorReport><WarningLevel>4</WarningLevel><PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsFormsIntegration" />
    <Reference Include="Softone.Lib, Version=1.0.0.0, Culture=neutral, PublicKeyToken=307c481590b30bd3, processorArchitecture=x86">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\..\..\..\..\Program Files\Soft1Core\Softone.Lib.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="SoftoneIntegration\S1Init.cs" />
    <Compile Include="SoftoneIntegration\JarvisObject.cs" />
    <Compile Include="SoftoneIntegration\JarvisRuntimeLoader.cs" />
    <Compile Include="SoftoneIntegration\JarvisHostFormBootstrap.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.config" />
  </ItemGroup>

  <Target Name="BuildJarvisRuntime" BeforeTargets="CollectJarvisRuntimeResources">
    <MSBuild Projects="$(MSBuildProjectDirectory)\S1Jarvis.Runtime\S1Jarvis.Runtime.csproj"
             Targets="Restore"
             Properties="Configuration=$(Configuration);Platform=AnyCPU"
             BuildInParallel="false" />
    <MSBuild Projects="$(MSBuildProjectDirectory)\S1Jarvis.Runtime\S1Jarvis.Runtime.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=AnyCPU"
             BuildInParallel="false" />
  </Target>

  <Target Name="CollectJarvisRuntimeResources" BeforeTargets="PrepareResources" DependsOnTargets="BuildJarvisRuntime">
    <PropertyGroup>
      <JarvisRuntimeOutput>$(MSBuildProjectDirectory)\S1Jarvis.Runtime\bin\$(Configuration)\</JarvisRuntimeOutput>
    </PropertyGroup>
    <Error Condition="!Exists('$(JarvisRuntimeOutput)S1Jarvis.Runtime.dll')"
           Text="S1Jarvis.Runtime.dll was not built; embedded runtime package cannot be created." />
    <ItemGroup>
      <EmbeddedResource Include="$(JarvisRuntimeOutput)*.dll">
        <LogicalName>S1Jarvis.Private.%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
    <Message Importance="High" Text="Embedding Jarvis runtime bundle: @(EmbeddedResource->'%(LogicalName)', ', ')" />
  </Target>

  <Target Name="BuildJarvisDeployPackage" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup><JarvisDeployDir>$(OutputPath)JarvisDeploy\</JarvisDeployDir></PropertyGroup>
    <MakeDir Directories="$(JarvisDeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(JarvisDeployDir)$(AssemblyName).dll" />
    <Copy SourceFiles="$(TargetPath).config" DestinationFiles="$(JarvisDeployDir)$(AssemblyName).dll.config" Condition="Exists('$(TargetPath).config')" />
    <Error Condition="!Exists('$(JarvisDeployDir)$(AssemblyName).dll')" Text="Jarvis deployment package was not created." />
    <Message Importance="High" Text="JarvisDeploy ready: $(JarvisDeployDir)$(AssemblyName).dll (Soft1 bootstrap + embedded runtime bundle)." />
  </Target>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{ACD54FA8-8A8D-4170-903F-8E9E1B6733AA}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>S1Jarvis</RootNamespace>
    <AssemblyName>S1Jarvis</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <!-- Ίδια σύμβαση deployment με το S1Courier: το build πέφτει κατευθείαν
         στο Soft1Core, ώστε το NETDLL να το βρίσκει χωρίς χειροκίνητο copy. -->
    <OutputPath>..\..\..\Program Files\Soft1Core\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <!-- Το SDK του Soft1 - ίδιο dll/hintpath με το S1Courier.
         Αν φτιάχνεις άλλη δομή φακέλων, προσάρμοσε το HintPath. -->
    <Reference Include="Softone.Lib, Version=1.0.0.0, Culture=neutral, PublicKeyToken=307c481590b30bd3, processorArchitecture=x86">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\..\..\..\..\Program Files\Soft1Core\Softone.Lib.dll</HintPath>
    </Reference>
    <!-- Ίδιο dll/version με το ήδη deployed (από S1Courier) στο Soft1Core -
         ΣΚΟΠΙΜΑ direct HintPath αντί για NuGet, ώστε να ΜΗΝ φέρει άλλο
         version μέσα στο ίδιο process (δύο DLLs, ίδιο AppDomain). -->
    <Reference Include="Newtonsoft.Json, Version=13.0.0.0, Culture=neutral, PublicKeyToken=30ad4fe6b2a6aeed">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\..\..\..\..\Program Files\Soft1Core\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <!-- ΝΕΟ 17/08, ρητό αίτημα χρήστη ("JARVISCOURIER" feature) - reuse
         ΑΥΤΟΥΣΙΩΝ των ICourierProvider/ShipmentRequest/ShipmentResult/
         CourierProviderFactory/4 courier providers από τον ήδη-deployed
         S1Courier.dll (HintPath, ΙΔΙΟ idiom με Softone.Lib/Newtonsoft.Json
         πιο πάνω - ΟΧΙ ProjectReference, ώστε να ΜΗΝ σέρνει μέσα ΟΛΑ τα
         NuGet dependencies του S1Courier - απλά η ήδη-χτισμένη/deployed
         assembly). ΔΕΝ χρησιμοποιούμε το S1Courier.Data.CourierRepository
         (νεκρός κώδικας εκεί - raw SqlClient πάνω σε ΛΑΘΟΣ πίνακα
         CCCCOURIER_PROVIDERS, ΟΧΙ τον πραγματικό CCCCRPROV) ούτε το
         S1Courier.Access.LicenseGuard (δικό του entitlement S1COURIER -
         ο Jarvis έχει ΔΙΚΟ ΤΟΥ, ξεχωριστό: JarvisLicenseGuard +
         "JARVISCOURIER", βλ. Core/JarvisCourier.cs). -->
    <Reference Include="S1Courier">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\..\..\..\..\Program Files\Soft1Core\S1Courier.dll</HintPath>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <!-- Για XlsxWriter.cs (ZipArchive) - export σε .xlsx χωρίς εξωτερικό
         NuGet dependency (π.χ. ClosedXML/EPPlus). -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="WindowsBase" />
    <!-- Για το JarvisHostForm.cs (fallback ElementHost wrapper). -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>
  <ItemGroup>
    <!-- PackageReference-style NuGet dependency (δουλεύει και σε classic,
         μη-SDK-style projects όπως αυτό, από NuGet 4+/VS2017+). Floating
         version ώστε το restore να τραβήξει ό,τι πιο πρόσφατο 1.0.x υπάρχει -
         το πραγματικό resolved version φαίνεται μετά το πρώτο restore. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <!-- ΝΕΟ 17/08, ρητό αίτημα χρήστη - πρόσβαση Jarvis σε email (Office 365
         πρώτα, βλ. JarvisEmailAccess.cs). Client credentials flow
         (Application permission Mail.Read, ΟΧΙ Delegated) - compile-checked
         ΞΕΧΩΡΙΣΤΑ πριν προστεθεί εδώ (throwaway net48 project + πραγματικό
         Softone.Lib.dll, καμία σύγκρουση dependencies/versions βρέθηκε).
         Extensions.Msal φέρνει ΚΑΙ το token cache (DPAPI-based) - δεν
         χρειάζεται σε αυτό το flow (client-credentials, όχι interactive),
         αλλά ΔΕΝ βλάπτει να μείνει αν χρειαστεί delegated flow αργότερα
         (π.χ. Gmail/SMTP wizards). -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.66.2" />
  </ItemGroup>
